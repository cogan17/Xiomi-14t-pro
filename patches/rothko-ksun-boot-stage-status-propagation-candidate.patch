+/*
+ * Serialize this exec startup path only. Policy/hide publication is not undone
+ * after failure, and the separate supercall boot-event path is not owned here.
+ */
+static int ksu_run_boot_stage(bool first_zygote)
+{
+    int ret;
+
+    mutex_lock(&ksu_boot_stage_lock);
+    ret = ksu_boot_error;
+    if (ret)
+        goto out_unlock;
+
+    if (first_zygote) {
+        if (!ksu_second_stage_done) {
+            ret = -EAGAIN;
+            goto out_unlock;
+        }
+        if (ksu_first_zygote_done)
+            goto out_unlock;
+        ret = cache_sid();
+        if (ret)
+            goto out_failed;
+        ret = setup_ksu_cred();
+        if (ret)
+            goto out_failed;
+        on_post_fs_data();
+        ksu_first_zygote_done = true;
+        static_branch_disable(&is_first_zygote);
+#ifndef CONFIG_KSU_SUSFS
+        ksu_stop_ksud_execve_hook();
+#endif
+    } else {
+        if (ksu_second_stage_done)
+            goto out_unlock;
+        ksu_selinux_hide_handle_second_stage();
+        ret = apply_kernelsu_rules();
+        if (ret)
+            goto out_failed;
+        ret = cache_sid();
+        if (ret)
+            goto out_failed;
+        ret = setup_ksu_cred();
+        if (ret)
+            goto out_failed;
+        ksu_second_stage_done = true;
+        static_branch_disable(&is_init_second_stage_not_executed);
+    }
+    goto out_unlock;
+
+out_failed:
+    ksu_boot_error = ret;
+    pr_err("KernelSU boot stage failed: %d\n", ret);
+out_unlock:
+    mutex_unlock(&ksu_boot_stage_lock);
+    return ret;
+}
