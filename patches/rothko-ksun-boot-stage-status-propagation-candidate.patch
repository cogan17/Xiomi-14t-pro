+    if (!path || !argv)
+        return 0;
+    if (static_branch_unlikely(&is_init_second_stage_not_executed) &&
+        !strcmp(path, "/system/bin/init") &&
+        check_argv(*argv, 1, "second_stage", buf, sizeof(buf)))
+        return ksu_run_boot_stage(false);
+    if (static_branch_unlikely(&is_first_zygote) &&
+        (!strcmp(path, "/system/bin/app_process") ||
+         !strcmp(path, "/system/bin/app_process32") ||
+         !strcmp(path, "/system/bin/app_process64")) &&
+        check_argv(*argv, 1, "-Xzygote", buf, sizeof(buf)))
+        return ksu_run_boot_stage(true);
+    return 0;
+}
