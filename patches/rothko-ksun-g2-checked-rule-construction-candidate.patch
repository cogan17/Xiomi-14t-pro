+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "memfd_file", "read"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "memfd_file", "write"));
+
+    // bootctl
+    KSU_BOOT_RULE(ksu_allow(db, "hwservicemanager", KERNEL_SU_DOMAIN, "dir", "search"));
+    KSU_BOOT_RULE(ksu_allow(db, "hwservicemanager", KERNEL_SU_DOMAIN, "file", "read"));
+    KSU_BOOT_RULE(ksu_allow(db, "hwservicemanager", KERNEL_SU_DOMAIN, "file", "open"));
+    KSU_BOOT_RULE(ksu_allow(db, "hwservicemanager", KERNEL_SU_DOMAIN, "process", "getattr"));
