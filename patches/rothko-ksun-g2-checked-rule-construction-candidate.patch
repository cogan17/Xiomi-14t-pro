+
+    // dumpsys, send fd
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "fd", "use"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "fifo_file", "write"));
