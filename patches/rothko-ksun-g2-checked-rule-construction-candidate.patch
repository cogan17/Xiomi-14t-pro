+    KSU_BOOT_RULE(ksu_allow(db, "kernel", "system_data_file", "dir", "search"));
+    KSU_BOOT_RULE(ksu_allow(db, "kernel", "packages_list_file", "file", "read"));
+    KSU_BOOT_RULE(ksu_allow(db, "kernel", "packages_list_file", "file", "open"));
+    KSU_BOOT_RULE(ksu_allow(db, "kernel", "apk_data_file", "dir", "read"));
+    KSU_BOOT_RULE(ksu_allow(db, "kernel", "apk_data_file", "dir", "open"));
+    KSU_BOOT_RULE(ksu_allow(db, "kernel", "apk_data_file", "dir", "search"));
+    KSU_BOOT_RULE(ksu_allow(db, "kernel", "apk_data_file", "file", "read"));
+    KSU_BOOT_RULE(ksu_allow(db, "kernel", "apk_data_file", "file", "open"));
+    return true;
+}
