+    KSU_BOOT_RULE(ksu_typeattribute(db, KERNEL_SU_DOMAIN, "netdomain"));
+    KSU_BOOT_RULE(ksu_typeattribute(db, KERNEL_SU_DOMAIN, "bluetoothdomain"));
+
+    // Create unconstrained file type
+    KSU_BOOT_RULE(ksu_type(db, KERNEL_SU_FILE, "file_type"));
+    KSU_BOOT_RULE(ksu_typeattribute(db, KERNEL_SU_FILE, "mlstrustedobject"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_FILE, ALL, ALL));
+
+    // allow all!
+    KSU_BOOT_RULE(ksu_allow(db, KERNEL_SU_DOMAIN, ALL, ALL, ALL));
+
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "unix_stream_socket", "read"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "unix_stream_socket", "write"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "unix_stream_socket", "connectto"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "unix_stream_socket", "getopt"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "unix_stream_socket", "getattr"));
+
+    // allow us do any ioctl
+    if (db->policyvers >= POLICYDB_VERSION_XPERMS_IOCTL) {
+        KSU_BOOT_RULE(ksu_allowxperm(db, KERNEL_SU_DOMAIN, ALL, "blk_file", ALL));
+        KSU_BOOT_RULE(ksu_allowxperm(db, KERNEL_SU_DOMAIN, ALL, "fifo_file", ALL));
