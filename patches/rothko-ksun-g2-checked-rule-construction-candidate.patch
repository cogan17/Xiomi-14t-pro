+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "fifo_file", "open"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "fifo_file", "getattr"));
