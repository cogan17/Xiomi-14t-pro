+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "unix_stream_socket", "write"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "unix_stream_socket", "connectto"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "unix_stream_socket", "getopt"));
+    KSU_BOOT_RULE(ksu_allow(db, "domain", KERNEL_SU_DOMAIN, "unix_stream_socket", "getattr"));
