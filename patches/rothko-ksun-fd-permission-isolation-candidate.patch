+int ksu_install_fd(void)
+{
+    struct ksu_driver_context *context;
+    struct file *filp;
+    int fd;
+
+    /* Preserve generic FD behavior with an explicitly zeroed permission set. */
+    context = kzalloc(sizeof(*context), GFP_KERNEL);
+    if (!context)
+        return -ENOMEM;
+
+    fd = get_unused_fd_flags(O_CLOEXEC);
+    if (fd < 0) {
+        pr_err("ksu_install_fd: failed to get unused fd\n");
+        kfree(context);
+        return fd;
+    }
+
+    filp = anon_inode_getfile("[ksu_driver]", &anon_ksu_fops, context, O_RDWR | O_CLOEXEC);
+    if (IS_ERR(filp)) {
+        pr_err("ksu_install_fd: failed to create anon inode file\n");
+        put_unused_fd(fd);
+        kfree(context);
+        return PTR_ERR(filp);
+    }
+
+    fd_install(fd, filp);
+    pr_info("ksu fd installed: %d for pid %d\n", fd, current->pid);
+    return fd;
+}
+
+/* No caller can create a session FD until a separately reviewed issuer exists. */
+bool ksu_is_su_session_fd(const struct file *filp)
+{
+    const struct ksu_driver_context *context = filp->private_data;
+
+    return context && (context->permissions & KSU_DRIVER_PERMISSION_SU_SESSION);
+}
 
