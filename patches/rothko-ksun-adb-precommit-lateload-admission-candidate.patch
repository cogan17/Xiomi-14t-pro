+/* Prepare only: the caller owns this unpublished credential until commit/abort. */
+int ksu_prepare_adb_root_cred(struct cred **out)
+{
+    struct cred *cred;
+    int ret;
+
+    if (!out)
+        return -EINVAL;
+    *out = NULL;
+    cred = prepare_creds();
+    if (!cred)
+        return -ENOMEM;
+    /* ADB startup is an init-domain root child, not an arbitrary profile escape. */
+    if (!uid_eq(cred->euid, GLOBAL_ROOT_UID) || !is_init(cred)) {
+        ret = -EACCES;
+        goto out_abort;
+    }
+    ret = transive_to_domain(KERNEL_SU_CONTEXT, cred, true);
+    if (ret)
+        goto out_abort;
+    if (!is_task_ksu_domain(cred)) {
+        ret = -EACCES;
+        goto out_abort;
+    }
+    *out = cred;
+    return 0;
+
+out_abort:
+    abort_creds(cred);
+    return ret;
 }
 
