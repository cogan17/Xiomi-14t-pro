diff --git a/kernel/selinux/selinux.h b/kernel/selinux/selinux.h
--- a/kernel/selinux/selinux.h
+++ b/kernel/selinux/selinux.h
@@ -13,7 +13,7 @@
 #define ZYGOTE_CONTEXT "u:r:zygote:s0"
 #define INIT_CONTEXT "u:r:init:s0"
 
-void setup_selinux(const char *, struct cred *);
+int setup_selinux(const char *, struct cred *);
 
 void setenforce(bool);
 
diff --git a/kernel/selinux/selinux.c b/kernel/selinux/selinux.c
--- a/kernel/selinux/selinux.c
+++ b/kernel/selinux/selinux.c
@@ -148,13 +148,13 @@
     return is_sid_match(cred, cached_init_sid, INIT_CONTEXT);
 }
 
-void setup_selinux(const char *domain, struct cred *cred)
-{
-    if (transive_to_domain(domain, cred, false)) {
-        pr_err("transive domain failed.\n");
-        return;
-    }
-}
+int setup_selinux(const char *domain, struct cred *cred)
+{
+    int ret = transive_to_domain(domain, cred, false);
+    if (ret)
+        pr_err("transive domain failed: %d\n", ret);
+    return ret;
+}
 
 void setup_ksu_cred(void)
 {
@@ -159,7 +159,8 @@
 void setup_ksu_cred(void)
 {
     if (ksu_cred) {
-        setup_selinux(KERNEL_SU_CONTEXT, ksu_cred);
+        if (setup_selinux(KERNEL_SU_CONTEXT, ksu_cred))
+            pr_err("Failed to initialize KernelSU credentials SELinux context\n");
     }
 }
 
diff --git a/kernel/policy/app_profile.c b/kernel/policy/app_profile.c
--- a/kernel/policy/app_profile.c
+++ b/kernel/policy/app_profile.c
@@ -205,9 +205,11 @@
     memcpy(&cred->cap_bset, &profile->capabilities.effective, sizeof(cred->cap_bset));
 
     setup_groups(profile, cred);
-    setup_selinux(profile->selinux_domain, cred);
-
-    commit_creds(cred);
+    ret = setup_selinux(profile->selinux_domain, cred);
+    if (ret)
+        goto out_abort_creds;
+
+    commit_creds(cred);
 
     if (likely(test_thread_flag(TIF_SECCOMP)))
         disable_seccomp();
@@ -241,8 +243,11 @@
         return -EINVAL;
     }
 
-    setup_selinux(KERNEL_SU_CONTEXT, cred);
-    commit_creds(cred);
+    if (setup_selinux(KERNEL_SU_CONTEXT, cred)) {
+        abort_creds(cred);
+        return -EINVAL;
+    }
+    commit_creds(cred);
 
     return 0;
 }
