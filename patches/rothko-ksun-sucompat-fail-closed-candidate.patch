diff --git a/kernel/feature/sucompat.c b/kernel/feature/sucompat.c
--- a/kernel/feature/sucompat.c
+++ b/kernel/feature/sucompat.c
@@ -257,13 +257,35 @@ int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
                                                          (const char __user *const __user *)argv_ptr->ptr.native,
                                                          GFP_KERNEL);
 
-    memcpy((void *)filename->name, ksud_path, sizeof(ksud_path));
-
+    /* Allocate before credential changes; allocation failure stays unprivileged. */
+    struct filename *replacement = getname_kernel(ksud_path);
+    if (IS_ERR(replacement)) {
+        ksu_sulog_emit_pending(pending_sucompat, PTR_ERR(replacement), GFP_KERNEL);
+        return 0;
+    }
+
     ret = escape_with_root_profile();
-    if (ret)
+    if (ret) {
         pr_err("escape_with_root_profile() failed: %d\n", ret);
+        putname(replacement);
+        /* Do not redirect to ksud if privilege escalation was denied. */
+        ksu_sulog_emit_pending(pending_sucompat, ret, GFP_KERNEL);
+        return 0;
+    }
 
-    ksu_sulog_emit_pending(pending_sucompat, ret, GFP_KERNEL);
+    /* A zero return may be an early no-op; require actual KSU credentials. */
+    if (!uid_eq(current_euid(), GLOBAL_ROOT_UID) ||
+        !susfs_is_current_ksu_domain()) {
+        pr_err("sucompat: no authorized KSU credential/domain after escape\\n");
+        putname(replacement);
+        ksu_sulog_emit_pending(pending_sucompat, -EPERM, GFP_KERNEL);
+        return 0;
+    }
+
+    /* Transfer the allocated filename only after authorization. */
+    *filename_ptr = replacement;
+    putname(filename);
+    ksu_sulog_emit_pending(pending_sucompat, 0, GFP_KERNEL);
 
     return 0;
 }
diff --git a/kernel/policy/app_profile.c b/kernel/policy/app_profile.c
--- a/kernel/policy/app_profile.c
+++ b/kernel/policy/app_profile.c
@@ -145,13 +145,19 @@ int escape_with_root_profile(void)
 #ifdef CONFIG_KSU_SUSFS
     if (susfs_is_current_ksu_domain()) {
 #else
     if (cred->euid.val == 0) {
 #endif
         pr_warn("Already root, don't escape!\\n");
+#ifdef CONFIG_KSU_SUSFS
+        ret = -EALREADY;
+#endif
         goto out_abort_creds;
     }
 
     if (test_thread_flag(TIF_KSU_DISABLE_ESCAPE_WITH_ROOT)) {
         pr_warn("TIF_KSU_DISABLE_ESCAPE_WITH_ROOT found, don't escape!\\n");
+#ifdef CONFIG_KSU_SUSFS
+        ret = -EPERM;
+#endif
         goto out_abort_creds;
     }
@@ -196,8 +196,9 @@
     // on older kernels, per-UID process accounting lives in user_struct.
 #if LINUX_VERSION_CODE >= KERNEL_VERSION(5, 14, 0)
-    if (set_cred_ucounts(cred)) {
+    ret = set_cred_ucounts(cred);
+    if (ret) {
         goto out_abort_creds;
     }
 #endif
 
     memcpy(&cred->cap_effective, &profile->capabilities.effective, sizeof(cred->cap_effective));
