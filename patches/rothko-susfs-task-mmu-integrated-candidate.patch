+#ifdef CONFIG_KSU_SUSFS_SUS_MAP
+		/* Preserve one pagemap entry per virtual page in this output window. */
+		if (pm.pos) {
+			unsigned long scan = start_vaddr;
+			unsigned long covered_end =
+				start_vaddr + ((unsigned long)pm.pos << PAGE_SHIFT);
+
+			while (scan < covered_end) {
+				struct vm_area_struct *vma = find_vma(mm, scan);
+				unsigned long mask_start, mask_end;
+
+				if (!vma || vma->vm_start >= covered_end)
