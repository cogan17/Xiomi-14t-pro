+				mask_start = max(scan, vma->vm_start);
+				mask_end = min(covered_end, vma->vm_end);
+				if (mask_end <= mask_start)
+					break;
+				if (vma->vm_file &&
+				    SUSFS_IS_INODE_SUS_MAP(file_inode(vma->vm_file)))
+					memset(&pm.buffer[(mask_start - start_vaddr) >> PAGE_SHIFT],
