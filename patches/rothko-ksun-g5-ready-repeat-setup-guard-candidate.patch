diff --git a/kernel/selinux/selinux.c b/kernel/selinux/selinux.c
--- a/kernel/selinux/selinux.c
+++ b/kernel/selinux/selinux.c
@@ -162,6 +162,15 @@
 int setup_ksu_cred(void)
 {
     int ret;
 
+    /*
+     * G5: do not mutate a credential already published to borrowers.
+     * READY is accepted without re-entering SELinux under a spinlock.
+     * Publication must remain gated by successful domain validation.
+     */
+    ret = ksu_ready_cred_setup_status();
+    if (ret != -EAGAIN)
+        return ret;
+
     if (!ksu_cred)
         return -EINVAL;
diff --git a/kernel/include/ksu.h b/kernel/include/ksu.h
--- a/kernel/include/ksu.h
+++ b/kernel/include/ksu.h
@@ -13,4 +13,5 @@
 const struct cred *ksu_borrow_ready_cred(void);
 void ksu_return_cred(const struct cred *cred);
 void ksu_unpublish_cred(void);
+int ksu_ready_cred_setup_status(void);
 int ksu_publish_ready_cred(void);
diff --git a/kernel/core/init.c b/kernel/core/init.c
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -89,5 +89,22 @@
 static DEFINE_SPINLOCK(ksu_cred_lock);
 static bool ksu_cred_ready;
 static bool ksu_cred_stopping;
+
+/* READY implies domain validation succeeded before publication. */
+int ksu_ready_cred_setup_status(void)
+{
+    unsigned long flags;
+    int ret;
+
+    spin_lock_irqsave(&ksu_cred_lock, flags);
+    if (ksu_cred_stopping)
+        ret = -ESHUTDOWN;
+    else if (ksu_cred_ready)
+        ret = ksu_cred ? 0 : -EINVAL;
+    else
+        ret = -EAGAIN;
+    spin_unlock_irqrestore(&ksu_cred_lock, flags);
+    return ret;
+}
 
 const struct cred *ksu_borrow_ready_cred(void)
