+				seq_pad(m, ' ');
+				if (spoofed_name)
+					seq_puts(m, spoofed_name);
+				seq_putc(m, '\n');
+				srcu_read_unlock(&susfs_srcu_open_redirect, idx);
+				return;
+			}
+			srcu_read_unlock(&susfs_srcu_open_redirect, idx);
+		}
+#endif
+#ifdef CONFIG_KSU_SUSFS_SUS_MAP
