+
+void ksu_drop_selinux_backup(void)
+{
+    struct selinux_policy *backup;
+
+    mutex_lock(&ksu_backup_mutex);
+    /* Wait for borrowers and permanently close admission before destruction. */
+    ksu_backup_closed = true;
+    backup = backup_sepolicy;
+    backup_sepolicy = NULL;
+    if (backup)
