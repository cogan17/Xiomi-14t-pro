+/* Lock order: live policy_mutex or hide mutex -> backup mutex, never reverse.
+ * All backup operations may sleep. A successful borrow holds the mutex until
+ * return; NULL has already released it. This is not a live rollback snapshot.
+ */
+static DEFINE_MUTEX(ksu_backup_mutex);
+static struct selinux_policy *backup_sepolicy;
+static bool ksu_backup_closed;
+
+struct selinux_policy *ksu_borrow_selinux_backup(void)
+{
+    mutex_lock(&ksu_backup_mutex);
+    if (!backup_sepolicy) {
+        mutex_unlock(&ksu_backup_mutex);
+        return NULL;
+    }
+    return backup_sepolicy;
+}
+
+void ksu_return_selinux_backup(void)
+{
+    mutex_unlock(&ksu_backup_mutex);
